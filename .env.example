# Copy to .env and fill in the values. docker compose and `npm run dev` both read it.

# --- Database container (docker compose) -----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medflow
# Host port for the database (bound to 127.0.0.1 only).
DB_PORT=5432

# Passwords for the three runtime roles. docker compose builds their connection
# strings; db:migrate creates the roles from them (never SUPERUSER/BYPASSRLS).
APP_DB_PASSWORD=change-me-app
PLATFORM_DB_PASSWORD=change-me-platform
PROVISIONER_DB_PASSWORD=change-me-provisioner

# --- Connection strings for `npm run dev` and the db:* scripts ---------------------
# Migrations and role setup (schema owner / superuser). Never used by the running app.
DATABASE_OWNER_URL=postgres://postgres:change-me@localhost:5432/medflow
# Clinic + compliance panels: row-level security enforced. Must be medflow_app.
DATABASE_URL=postgres://medflow_app:change-me-app@localhost:5432/medflow
# Operations console: no access to any clinical table. Must be medflow_platform.
PLATFORM_DATABASE_URL=postgres://medflow_platform:change-me-platform@localhost:5432/medflow
# Clinic onboarding + admin rescue only. Remove to switch those two features off.
PROVISIONER_DATABASE_URL=postgres://medflow_provisioner:change-me-provisioner@localhost:5432/medflow

# Database TLS (docs/OPERATIONS.md). docker compose sets verify-full for its
# services. For the db:* scripts and ops:verify-restore from the host:
# DATABASE_SSL=verify-full
# DATABASE_SSL_CA=./certs/ca.crt
# Where scripts/ops/make-db-certs.sh wrote the certificates (default ./certs).
# DB_CERTS_DIR=./certs

# --- Auth -------------------------------------------------------------------------
# Signs clinic staff sessions. Generate: openssl rand -base64 32
AUTH_SECRET=
# Signs operations-console sessions. Must be different from AUTH_SECRET.
PLATFORM_AUTH_SECRET=
# Public URL of the app (https in production enables __Secure- cookies).
AUTH_URL=http://localhost:3000

# --- Encryption ------------------------------------------------------------------
# Encrypts lab documents, clinical notes and WhatsApp tokens in the database.
# Required: the server will not start in production without it. 32 bytes, base64:
#   openssl rand -base64 32
# Store a copy in a password manager: without it those records cannot be read.
DATA_ENCRYPTION_KEY=
# Only while rotating keys (npm run ops:rotate-key): earlier keys, comma-separated.
# DATA_ENCRYPTION_KEYS_OLD=

# --- Messaging (WhatsApp module) ------------------------------------------------
# "cloud" sends through the Meta WhatsApp Cloud API; "log" only records messages
# (development, or while Meta business verification is pending).
WHATSAPP_DRIVER=cloud
# Prefixed to 10-digit local mobile numbers.
DEFAULT_COUNTRY_CODE=91

# --- First Super Admin (created by db:bootstrap / docker setup if missing) ---------
# Password: 12+ characters. Or run: npm run db:create-platform-admin -- <email> <password>
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# --- Backups ------------------------------------------------------------------------
# The backup public key (never the private key). scripts/ops/backup.sh refuses
# to run without it. See docs/OPERATIONS.md, "Backups".
# BACKUP_PUBLIC_KEY=/etc/nuvalyf/backup-public.asc

# --- Optional -------------------------------------------------------------------------
# Number of reverse proxies in front of the app that append to X-Forwarded-For
# (nginx, Caddy, a load balancer). Client IPs for login limits and the audit
# trail are read from that position, so a client cannot fake them. Default 1.
# TRUST_PROXY_HOPS=1
# Locale for dates, and the timezone the operations console displays in.
# APP_LOCALE=en-IN
# PLATFORM_TIMEZONE=Asia/Kolkata
# Set to "require" for managed Postgres that enforces TLS.
# DATABASE_SSL=require
# Connection pool size per role per app instance.
# DATABASE_POOL_MAX=10
